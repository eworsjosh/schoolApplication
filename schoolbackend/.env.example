# ========================================================
# School Management Portal - Backend Environment Variables
# ========================================================

# Django Secret Key (Generate a random string for production)
SECRET_KEY=django-insecure-change-this-to-a-very-secret-random-key-in-production

# Debug Mode (Set to False in production)
DEBUG=True

# Database URL
# In local development with SQLite (default if omitted):
# DATABASE_URL=sqlite:///db.sqlite3
# In production on Railway or Render (PostgreSQL):
# DATABASE_URL=postgresql://user:password@host:5432/dbname
DATABASE_URL=

# Allowed Hosts (comma-separated list of domains)
# Example for production: school-backend.up.railway.app,myschool.com
ALLOWED_HOSTS=localhost,127.0.0.1

# CSRF Trusted Origins (comma-separated list of frontend URLs)
# Example: https://myschool-portal.netlify.app,https://school-backend.up.railway.app
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# CORS Allowed Origins (frontend domain that will call this API)
# Example: https://myschool-portal.netlify.app
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Set to True only if you want to allow requests from any origin (e.g. during quick testing)
CORS_ALLOW_ALL_ORIGINS=False

# Default School Name fallback (overridden by database SchoolConfig)
SCHOOL_NAME=School Management Portal

# Email Configuration (Optional - for notifications/password resets)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Paystack Online Payments (Optional - for online school fee payment)
PAYSTACK_SECRET_KEY=
PAYSTACK_CALLBACK_URL=
