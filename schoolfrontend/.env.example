# =========================================================
# School Management Portal - Frontend Environment Variables
# =========================================================

# The URL of your Django backend API
# In local development: http://127.0.0.1:8000
# In production on Railway or Render: https://your-school-backend.up.railway.app
VITE_API_URL=http://127.0.0.1:8000

# Default School Name (used before API responds, or as fallback)
VITE_SCHOOL_NAME=School Management Portal
